<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core, Application and profile-store unit tests. Must not reference xBIM or WPF. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EngineeringModelQA.Core\EngineeringModelQA.Core.csproj" />
    <ProjectReference Include="..\..\src\EngineeringModelQA.Application\EngineeringModelQA.Application.csproj" />
    <ProjectReference Include="..\..\src\EngineeringModelQA.Infrastructure\EngineeringModelQA.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\samples\profiles\*.json" LinkBase="samples\profiles" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
