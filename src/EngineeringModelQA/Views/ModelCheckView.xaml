<UserControl x:Class="EngineeringModelQA.Views.ModelCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EngineeringModelQA.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ModelCheckViewModel}"
             d:DesignWidth="1200" d:DesignHeight="820">
    <UserControl.Resources>
        <!-- Summary card: icon circle, title, count, subtitle. Tag carries the accent brush. -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CardCount" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,12,14" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Inputs: Model file, Check profile, Run Check / Cancel, Export Report -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Model file" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource InputBox}" Tag="Choose an IFC4 file (.ifc)"
                             Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}"
                             AutomationProperties.AutomationId="ModelPathBox" AutomationProperties.Name="Model file" />
                    <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Padding="0" Margin="-1,0,0,0"
                            BorderBrush="{StaticResource BorderBrush}" Command="{Binding BrowseCommand}"
                            ToolTip="Browse for an IFC file"
                            AutomationProperties.AutomationId="BrowseButton" AutomationProperties.Name="Browse for model file">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="16" />
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Check profile" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="DisplayName"
                          MinHeight="42" Padding="10,0" VerticalContentAlignment="Center" IsEnabled="{Binding IsIdle}"
                          AutomationProperties.AutomationId="ProfileCombo" AutomationProperties.Name="Check profile" />
            </StackPanel>

            <Grid Grid.Column="4" VerticalAlignment="Bottom">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunCheckCommand}" MinWidth="170"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="RunCheckButton" AutomationProperties.Name="Run Check">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" />
                        <TextBlock Text="Run Check" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OutlineButton}" Command="{Binding CancelCommand}" MinWidth="170"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="CancelButton" AutomationProperties.Name="Cancel">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,10,0" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>
            </Grid>

            <Button Grid.Column="6" Style="{StaticResource OutlineButton}" Command="{Binding ExportReportCommand}"
                    VerticalAlignment="Bottom" MinWidth="170" ToolTip="Open the Reports page for the latest check"
                    AutomationProperties.AutomationId="ExportReportButton" AutomationProperties.Name="Export Report">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,10,0" />
                    <TextBlock Text="Export Report" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Progress and messages -->
        <StackPanel Grid.Row="1">
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="6" Background="{StaticResource InfoBackgroundBrush}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" Width="160" Height="6" VerticalAlignment="Center"
                                 Foreground="{StaticResource PrimaryBrush}" Background="White" BorderThickness="0" />
                    <TextBlock Text="{Binding ProgressText}" AutomationProperties.AutomationId="ProgressText" />
                </DockPanel>
            </Border>
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="6"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource InfoBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageKind}" Value="Warning">
                                <Setter Property="Background" Value="{StaticResource WarningBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MessageKind}" Value="Error">
                                <Setter Property="Background" Value="{StaticResource ErrorBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" AutomationProperties.AutomationId="MessageText" />
            </Border>
        </StackPanel>

        <!-- Summary cards -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="-8,16,-8,0">
            <Border Style="{StaticResource Card}" Margin="8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource ErrorBackgroundBrush}" />
                        <TextBlock Text="&#xE783;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource ErrorBrush}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="Missing marks" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MissingMarks, StringFormat=N0}" Style="{StaticResource CardCount}"
                                   AutomationProperties.AutomationId="MissingMarksCount" />
                        <TextBlock Text="Elements without a member mark" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource WarningBackgroundBrush}" />
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource WarningBrush}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="Duplicate marks" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding DuplicateMarks, StringFormat=N0}" Style="{StaticResource CardCount}"
                                   AutomationProperties.AutomationId="DuplicateMarksCount" />
                        <TextBlock Text="Elements sharing the same mark" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Top">
                        <Ellipse Fill="{StaticResource InfoBackgroundBrush}" />
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="28" Foreground="{StaticResource InfoBrush}" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="Naming issues" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding NamingIssues, StringFormat=N0}" Style="{StaticResource CardCount}"
                                   AutomationProperties.AutomationId="NamingIssuesCount" />
                        <TextBlock Text="Marks not matching naming rules" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>

        <!-- Findings table and details -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ResultsCaption}" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"
                                   AutomationProperties.AutomationId="ResultsCaption" />
                        <TextBlock Text="{Binding FindingsHeader}" Style="{StaticResource SectionTitle}"
                                   AutomationProperties.AutomationId="FindingsHeader" />
                    </DockPanel>

                    <!-- Filter row (the mockup has none; kept to one compact line) -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,14,0,10" IsEnabled="{Binding HasResults}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Clear filters"
                                Command="{Binding ClearFiltersCommand}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="ClearFiltersButton" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterCombo}" ItemsSource="{Binding TypeOptions}"
                                  SelectedItem="{Binding SelectedType}"
                                  AutomationProperties.AutomationId="TypeFilter" AutomationProperties.Name="Element type filter" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterCombo}" ItemsSource="{Binding RuleOptions}"
                                  SelectedItem="{Binding SelectedRule}"
                                  AutomationProperties.AutomationId="RuleFilter" AutomationProperties.Name="Rule filter" />
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource FilterCombo}" ItemsSource="{Binding SeverityOptions}"
                                  SelectedItem="{Binding SelectedSeverity}"
                                  AutomationProperties.AutomationId="SeverityFilter" AutomationProperties.Name="Severity filter" />
                        <TextBox Style="{StaticResource InputBox}" MinHeight="34" Tag="Search element, ID, rule or value"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search findings" />
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding WarningsText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Foreground="{StaticResource WarningBrush}" MaxHeight="60" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="WarningsText" />

                    <Grid>
                        <DataGrid Style="{StaticResource FindingsGrid}" ItemsSource="{Binding Findings}"
                                  SelectedItem="{Binding SelectedFinding}"
                                  AutomationProperties.AutomationId="FindingsGrid" AutomationProperties.Name="Findings">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Severity" Width="120" SortMemberPath="Severity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SeverityIcon}" />
                                                <TextBlock Text="{Binding SeverityText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Element" Binding="{Binding Element}" Width="1.3*" MinWidth="150" />
                                <DataGridTextColumn Header="Type" Binding="{Binding EntityType}" Width="100" />
                                <DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="*" MinWidth="130" />
                                <DataGridTextColumn Header="Observed" Binding="{Binding Observed}" Width="*" MinWidth="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40"
                                   Visibility="{Binding HasEmptyText, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.AutomationId="EmptyText" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Finding details" Style="{StaticResource SectionTitle}" Margin="0,0,0,18" />
                    <TextBlock DockPanel.Dock="Top" Text="Select a finding to see its details." Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedFinding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Element:" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Element}" Style="{StaticResource DetailValue}"
                                           AutomationProperties.AutomationId="DetailElement" />
                                <TextBlock Grid.Row="1" Text="Element ID:" Style="{StaticResource DetailLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GlobalId, Mode=OneWay}" IsReadOnly="True"
                                         BorderThickness="0" Padding="0" Background="Transparent" Margin="0,0,0,14"
                                         FontFamily="Consolas" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="DetailElementId" AutomationProperties.Name="Element ID" />
                                <TextBlock Grid.Row="2" Text="Rule:" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Rule}" Style="{StaticResource DetailValue}"
                                           AutomationProperties.AutomationId="DetailRule" />
                                <TextBlock Grid.Row="3" Text="Expected:" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Expected}" Style="{StaticResource DetailValue}"
                                           AutomationProperties.AutomationId="DetailExpected" />
                                <TextBlock Grid.Row="4" Text="Observed:" Style="{StaticResource DetailLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Observed}" Style="{StaticResource DetailValue}"
                                           AutomationProperties.AutomationId="DetailObserved" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,18" />
                            <TextBlock Text="Guidance" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,0,0,6"
                                       AutomationProperties.AutomationId="DetailExplanation" />
                            <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap" AutomationProperties.AutomationId="DetailGuidance" />
                            <Button Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,24,0,0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Command="{Binding DataContext.CopyElementIdCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="CopyElementIdButton" AutomationProperties.Name="Copy element ID">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Copy element ID" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DataContext.CopyStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="CopyStatus" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
