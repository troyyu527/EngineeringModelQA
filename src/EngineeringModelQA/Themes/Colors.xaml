<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Palette taken from the mockups (docs/mockups/img1-4.png). -->
    <Color x:Key="NavyColor">#1B2A4A</Color>
    <Color x:Key="TealColor">#14808A</Color>

    <SolidColorBrush x:Key="RailBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="RailSelectedBrush" Color="#2B3F66" />
    <SolidColorBrush x:Key="RailHoverBrush" Color="#24365A" />
    <SolidColorBrush x:Key="RailTextBrush" Color="#E8EDF5" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0F6C75" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0B5A61" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CDF3F5" />
    <SolidColorBrush x:Key="HoverRowBrush" Color="#F1F8F9" />

    <SolidColorBrush x:Key="PageBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE2E9" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#A9B0BA" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#D93A3A" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E39A0E" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4DB" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1E73C8" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#E3EEFB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9E61" />

    <!-- Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10 (same code points). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
